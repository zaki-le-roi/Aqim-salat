{"source":"quran-json / The Noble Quran Encyclopedia; Arabic Uthmani text reproduced verbatim","surahs":[{"id":81,"name":"التكوير","type":"meccan","total_verses":29,"verses":[{"id":1,"text":"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ"},{"id":2,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ"},{"id":3,"text":"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ"},{"id":4,"text":"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ"},{"id":5,"text":"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ"},{"id":6,"text":"وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ"},{"id":7,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ"},{"id":8,"text":"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ"},{"id":9,"text":"بِأَيِّ ذَنۢبٖ قُتِلَتۡ"},{"id":10,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتۡ"},{"id":11,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ"},{"id":12,"text":"وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ"},{"id":13,"text":"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ"},{"id":14,"text":"عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ"},{"id":15,"text":"فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ"},{"id":16,"text":"ٱلۡجَوَارِ ٱلۡكُنَّسِ"},{"id":17,"text":"وَٱلَّيۡلِ إِذَا عَسۡعَسَ"},{"id":18,"text":"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ"},{"id":19,"text":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ"},{"id":20,"text":"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ"},{"id":21,"text":"مُّطَاعٖ ثَمَّ أَمِينٖ"},{"id":22,"text":"وَمَا صَاحِبُكُم بِمَجۡنُونٖ"},{"id":23,"text":"وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ"},{"id":24,"text":"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ"},{"id":25,"text":"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ"},{"id":26,"text":"فَأَيۡنَ تَذۡهَبُونَ"},{"id":27,"text":"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ"},{"id":28,"text":"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ"},{"id":29,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ"}]},{"id":82,"name":"الإنفطار","type":"meccan","total_verses":19,"verses":[{"id":1,"text":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ"},{"id":2,"text":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ"},{"id":3,"text":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ"},{"id":4,"text":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ"},{"id":5,"text":"عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ"},{"id":6,"text":"يَـٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ"},{"id":7,"text":"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ"},{"id":8,"text":"فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ"},{"id":9,"text":"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ"},{"id":10,"text":"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ"},{"id":11,"text":"كِرَامٗا كَٰتِبِينَ"},{"id":12,"text":"يَعۡلَمُونَ مَا تَفۡعَلُونَ"},{"id":13,"text":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ"},{"id":14,"text":"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ"},{"id":15,"text":"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ"},{"id":16,"text":"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ"},{"id":17,"text":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ"},{"id":18,"text":"ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ"},{"id":19,"text":"يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ"}]},{"id":83,"name":"المطففين","type":"meccan","total_verses":36,"verses":[{"id":1,"text":"وَيۡلٞ لِّلۡمُطَفِّفِينَ"},{"id":2,"text":"ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ يَسۡتَوۡفُونَ"},{"id":3,"text":"وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ يُخۡسِرُونَ"},{"id":4,"text":"أَلَا يَظُنُّ أُوْلَـٰٓئِكَ أَنَّهُم مَّبۡعُوثُونَ"},{"id":5,"text":"لِيَوۡمٍ عَظِيمٖ"},{"id":6,"text":"يَوۡمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلۡعَٰلَمِينَ"},{"id":7,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلۡفُجَّارِ لَفِي سِجِّينٖ"},{"id":8,"text":"وَمَآ أَدۡرَىٰكَ مَا سِجِّينٞ"},{"id":9,"text":"كِتَٰبٞ مَّرۡقُومٞ"},{"id":10,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"},{"id":11,"text":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوۡمِ ٱلدِّينِ"},{"id":12,"text":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعۡتَدٍ أَثِيمٍ"},{"id":13,"text":"إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ"},{"id":14,"text":"كَلَّاۖ بَلۡۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ"},{"id":15,"text":"كَلَّآ إِنَّهُمۡ عَن رَّبِّهِمۡ يَوۡمَئِذٖ لَّمَحۡجُوبُونَ"},{"id":16,"text":"ثُمَّ إِنَّهُمۡ لَصَالُواْ ٱلۡجَحِيمِ"},{"id":17,"text":"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ"},{"id":18,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلۡأَبۡرَارِ لَفِي عِلِّيِّينَ"},{"id":19,"text":"وَمَآ أَدۡرَىٰكَ مَا عِلِّيُّونَ"},{"id":20,"text":"كِتَٰبٞ مَّرۡقُومٞ"},{"id":21,"text":"يَشۡهَدُهُ ٱلۡمُقَرَّبُونَ"},{"id":22,"text":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٍ"},{"id":23,"text":"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ"},{"id":24,"text":"تَعۡرِفُ فِي وُجُوهِهِمۡ نَضۡرَةَ ٱلنَّعِيمِ"},{"id":25,"text":"يُسۡقَوۡنَ مِن رَّحِيقٖ مَّخۡتُومٍ"},{"id":26,"text":"خِتَٰمُهُۥ مِسۡكٞۚ وَفِي ذَٰلِكَ فَلۡيَتَنَافَسِ ٱلۡمُتَنَٰفِسُونَ"},{"id":27,"text":"وَمِزَاجُهُۥ مِن تَسۡنِيمٍ"},{"id":28,"text":"عَيۡنٗا يَشۡرَبُ بِهَا ٱلۡمُقَرَّبُونَ"},{"id":29,"text":"إِنَّ ٱلَّذِينَ أَجۡرَمُواْ كَانُواْ مِنَ ٱلَّذِينَ ءَامَنُواْ يَضۡحَكُونَ"},{"id":30,"text":"وَإِذَا مَرُّواْ بِهِمۡ يَتَغَامَزُونَ"},{"id":31,"text":"وَإِذَا ٱنقَلَبُوٓاْ إِلَىٰٓ أَهۡلِهِمُ ٱنقَلَبُواْ فَكِهِينَ"},{"id":32,"text":"وَإِذَا رَأَوۡهُمۡ قَالُوٓاْ إِنَّ هَـٰٓؤُلَآءِ لَضَآلُّونَ"},{"id":33,"text":"وَمَآ أُرۡسِلُواْ عَلَيۡهِمۡ حَٰفِظِينَ"},{"id":34,"text":"فَٱلۡيَوۡمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلۡكُفَّارِ يَضۡحَكُونَ"},{"id":35,"text":"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ"},{"id":36,"text":"هَلۡ ثُوِّبَ ٱلۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ"}]},{"id":84,"name":"الإنشقاق","type":"meccan","total_verses":25,"verses":[{"id":1,"text":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ"},{"id":2,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"},{"id":3,"text":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ"},{"id":4,"text":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ"},{"id":5,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"},{"id":6,"text":"يَـٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ"},{"id":7,"text":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ"},{"id":8,"text":"فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا"},{"id":9,"text":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا"},{"id":10,"text":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ"},{"id":11,"text":"فَسَوۡفَ يَدۡعُواْ ثُبُورٗا"},{"id":12,"text":"وَيَصۡلَىٰ سَعِيرًا"},{"id":13,"text":"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا"},{"id":14,"text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"},{"id":15,"text":"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا"},{"id":16,"text":"فَلَآ أُقۡسِمُ بِٱلشَّفَقِ"},{"id":17,"text":"وَٱلَّيۡلِ وَمَا وَسَقَ"},{"id":18,"text":"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ"},{"id":19,"text":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ"},{"id":20,"text":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ"},{"id":21,"text":"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩"},{"id":22,"text":"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ"},{"id":23,"text":"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ"},{"id":24,"text":"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ"},{"id":25,"text":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ"}]},{"id":85,"name":"البروج","type":"meccan","total_verses":22,"verses":[{"id":1,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلۡبُرُوجِ"},{"id":2,"text":"وَٱلۡيَوۡمِ ٱلۡمَوۡعُودِ"},{"id":3,"text":"وَشَاهِدٖ وَمَشۡهُودٖ"},{"id":4,"text":"قُتِلَ أَصۡحَٰبُ ٱلۡأُخۡدُودِ"},{"id":5,"text":"ٱلنَّارِ ذَاتِ ٱلۡوَقُودِ"},{"id":6,"text":"إِذۡ هُمۡ عَلَيۡهَا قُعُودٞ"},{"id":7,"text":"وَهُمۡ عَلَىٰ مَا يَفۡعَلُونَ بِٱلۡمُؤۡمِنِينَ شُهُودٞ"},{"id":8,"text":"وَمَا نَقَمُواْ مِنۡهُمۡ إِلَّآ أَن يُؤۡمِنُواْ بِٱللَّهِ ٱلۡعَزِيزِ ٱلۡحَمِيدِ"},{"id":9,"text":"ٱلَّذِي لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدٌ"},{"id":10,"text":"إِنَّ ٱلَّذِينَ فَتَنُواْ ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ ثُمَّ لَمۡ يَتُوبُواْ فَلَهُمۡ عَذَابُ جَهَنَّمَ وَلَهُمۡ عَذَابُ ٱلۡحَرِيقِ"},{"id":11,"text":"إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ لَهُمۡ جَنَّـٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡكَبِيرُ"},{"id":12,"text":"إِنَّ بَطۡشَ رَبِّكَ لَشَدِيدٌ"},{"id":13,"text":"إِنَّهُۥ هُوَ يُبۡدِئُ وَيُعِيدُ"},{"id":14,"text":"وَهُوَ ٱلۡغَفُورُ ٱلۡوَدُودُ"},{"id":15,"text":"ذُو ٱلۡعَرۡشِ ٱلۡمَجِيدُ"},{"id":16,"text":"فَعَّالٞ لِّمَا يُرِيدُ"},{"id":17,"text":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡجُنُودِ"},{"id":18,"text":"فِرۡعَوۡنَ وَثَمُودَ"},{"id":19,"text":"بَلِ ٱلَّذِينَ كَفَرُواْ فِي تَكۡذِيبٖ"},{"id":20,"text":"وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطُۢ"},{"id":21,"text":"بَلۡ هُوَ قُر