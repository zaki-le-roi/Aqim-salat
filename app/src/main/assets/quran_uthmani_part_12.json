{"source":"quran-json / The Noble Quran Encyclopedia; Arabic Uthmani text reproduced verbatim","surahs":[{"id":89,"name":"الفجر","type":"meccan","total_verses":30,"verses":[{"id":1,"text":"وَٱلۡفَجۡرِ"},{"id":2,"text":"وَلَيَالٍ عَشۡرٖ"},{"id":3,"text":"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ"},{"id":4,"text":"وَٱلَّيۡلِ إِذَا يَسۡرِ"},{"id":5,"text":"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ"},{"id":6,"text":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ"},{"id":7,"text":"إِرَمَ ذَاتِ ٱلۡعِمَادِ"},{"id":8,"text":"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ"},{"id":9,"text":"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ"},{"id":10,"text":"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ"},{"id":11,"text":"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ"},{"id":12,"text":"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ"},{"id":13,"text":"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ"},{"id":14,"text":"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ"},{"id":15,"text":"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ"},{"id":16,"text":"وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ"},{"id":17,"text":"كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ"},{"id":18,"text":"وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ"},{"id":19,"text":"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا"},{"id":20,"text":"وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا"},{"id":21,"text":"كَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا"},{"id":22,"text":"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا"},{"id":23,"text":"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ"},{"id":24,"text":"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي"},{"id":25,"text":"فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ"},{"id":26,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ"},{"id":27,"text":"يَـٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ"},{"id":28,"text":"ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ"},{"id":29,"text":"فَٱدۡخُلِي فِي عِبَٰدِي"},{"id":30,"text":"وَٱدۡخُلِي جَنَّتِي"}]},{"id":90,"n