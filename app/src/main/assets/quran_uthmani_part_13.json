{"source":"quran-json / The Noble Quran Encyclopedia; Arabic Uthmani text reproduced verbatim","surahs":[{"id":97,"name":"القدر","type":"meccan","total_verses":5,"verses":[{"id":1,"text":"إِنَّآ أَنزَلۡنَٰهُ فِي لَيۡلَةِ ٱلۡقَدۡرِ"},{"id":2,"text":"وَمَآ أَدۡرَىٰكَ مَا لَيۡلَةُ ٱلۡقَدۡرِ"},{"id":3,"text":"لَيۡلَةُ ٱلۡقَدۡرِ خَيۡرٞ مِّنۡ أَلۡفِ شَهۡرٖ"},{"id":4,"text":"تَنَزَّلُ ٱلۡمَلَـٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِم مِّن كُلِّ أَمۡرٖ"},{"id":5,"text":"سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ ٱلۡفَجۡرِ"}]},{"id":98,"name":"البينة","type":"medinan","total_verses":8,"verses":[{"id":1,"text":"لَمۡ يَكُنِ ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ وَٱلۡمُشۡرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأۡتِيَهُمُ ٱلۡبَيِّنَةُ"},{"id":2,"text":"رَسُولٞ مِّنَ ٱللَّهِ يَتۡلُواْ صُحُفٗا مُّطَهَّرَةٗ"},{"id":3,"text":"فِيهَا كُتُبٞ قَيِّمَةٞ"},{"id":4,"text":"وَمَا تَفَرَّقَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ إِلَّا مِنۢ بَعۡدِ مَا جَآءَتۡهُمُ ٱلۡبَيِّنَةُ"},{"id":5,"text":"وَمَآ أُمِرُوٓاْ إِلَّا لِيَعۡبُدُواْ ٱللَّهَ مُخۡلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُواْ ٱلصَّلَوٰةَ وَيُؤۡتُواْ ٱلزَّكَوٰةَۚ وَذَٰلِكَ دِينُ ٱلۡقَيِّمَةِ"},{"id":6,"text":"إِنَّ ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ وَٱلۡمُشۡرِكِينَ فِي نَارِ جَهَنَّمَ خَٰلِدِينَ فِيهَآۚ أُوْلَـٰٓئِكَ هُمۡ شَرُّ ٱلۡبَرِيَّةِ"},{"id":7,"text":"إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ أُوْلَـٰٓئِكَ هُمۡ خَيۡرُ ٱلۡبَرِيَّةِ"},{"id":8,"text":"جَزَآؤُهُمۡ عِندَ رَبِّهِمۡ جَنَّـٰتُ عَدۡنٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدٗاۖ رَّضِيَ ٱللَّهُ عَنۡهُمۡ وَرَضُواْ عَنۡهُۚ ذَٰلِكَ لِمَنۡ خَشِيَ رَبَّهُۥ"}]},{"id":99,"name":"الزلزلة","type":"medinan","total_verses":8,"verses":[{"id":1,"text":"إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا"},{"id":2,"text":"وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا"},{"id":3,"text":"وَقَالَ ٱلۡإِنسَٰنُ مَا لَهَا"},{"id":4,"text":"يَوۡمَئِذٖ تُحَدِّثُ أَخۡبَارَهَا"},{"id":5,"text":"بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا"},{"id":6,"text":"يَوۡمَئِذٖ يَصۡدُرُ ٱلنَّاسُ أَشۡتَاتٗا لِّيُرَوۡاْ أَعۡمَٰلَهُمۡ"},{"id":7,"text":"فَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرٗا يَرَهُۥ"},{"id":8,"text":"وَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٖ شَرّٗا يَرَهُۥ"}]},{"id":100,"name":"العاديات","type":"meccan","total_verses":11,"verses":[{"id":1,"text":"وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا"},{"id":2,"text":"فَٱلۡمُورِيَٰتِ قَدۡحٗا"},{"id":3,"text":"فَٱلۡمُغِيرَٰتِ صُبۡحٗا"},{"id":4,"text":"فَأَثَرۡنَ بِهِۦ نَقۡعٗا"},{"id":5,"text":"فَوَسَطۡنَ بِهِۦ جَمۡعًا"},{"id":6,"text":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ"},{"id":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ"},{"id":8,"text":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ"},{"id":9,"text":"۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ"},{"id":10,"text":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ"},{"id":11,"text":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ"}]},{"id":101,"name":"القارعة","type":"meccan","total_verses":11,"verses":[{"id":1,"text":"ٱلۡقَارِعَةُ"},{"id":2,"text":"مَا ٱلۡقَارِعَةُ"},{"id":3,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ"},{"id":4,"text":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ"},{"id":5,"text":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ"},{"id":6,"text":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ"},{"id":7,"text":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ"},{"id":8,"text":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ"},{"id":9,"text":"فَأُمُّهُۥ هَاوِيَةٞ"},{"id":10,"text":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ"},{"id":11,"text":"نَارٌ حَامِيَةُۢ"}]},{"id":102,"name":"التكاثر","type":"meccan","total_verses":8,"verses":[{"id":1,"text":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ"},{"id":2,"text":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ"},{"id":3,"text":"كَلَّا سَوۡفَ تَعۡلَمُونَ"},{"id":4,"text":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ"},{"id":5,"text":"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ"},{"id":6,"text":"لَتَرَوُنَّ ٱلۡجَحِيمَ"},{"id":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ"},{"id":8,"text":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ"}]},{"id":103,"name":"العصر","type":"meccan","total_verses":3,"verses":[{"id":1,"text":"وَٱلۡعَصۡرِ"},{"id":2,"text":"إِنَّ ٱلۡإِنسَٰنَ لَفِي خُسۡرٍ"},{"id":3,"text":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ وَتَوَاصَوۡاْ بِٱلۡحَقِّ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ"}]},{"id":104,"name":"الهمزة","type":"meccan","total_verses":9,"verses":[{"id":1,"text":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ"},{"id":2,"text":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ"},{"id":3,"text":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ"},{"id":4,"text":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ"},{"id":5,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ"},{"id":6,"text":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ"},{"id":7,"text":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ"},{"id":8,"text":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ"},{"id":9,"text":"فِي عَمَدٖ مُّمَدَّدَةِۭ"}]}]}