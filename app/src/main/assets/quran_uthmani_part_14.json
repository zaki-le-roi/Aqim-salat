{"source":"quran-json / The Noble Quran Encyclopedia; Arabic Uthmani text reproduced verbatim","surahs":[{"id":105,"name":"الفيل","type":"meccan","total_verses":5,"verses":[{"id":1,"text":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ"},{"id":2,"text":"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٖ"},{"id":3,"text":"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ"},{"id":4,"text":"تَرۡمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ"},{"id":5,"text":"فَجَعَلَهُمۡ كَعَصۡفٖ مَّأۡكُولِۭ"}]},{"id":106,"name":"قريش","type":"meccan","total_verses":4,"verses":[{"id":1,"text":"لِإِيلَٰفِ قُرَيۡشٍ"},{"id":2,"text":"إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ"},{"id":3,"text":"فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ"},{"id":4,"text":"ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ"}]},{"id":107,"name":"الماعون","type":"meccan","total_verses":7,"verses":[{"id":1,"text":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ"},{"id":2,"text":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ"},{"id":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ"},{"id":4,"text":"فَوَيۡلٞ لِّلۡمُصَلِّينَ"},{"id":5,"text":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ"},{"id":6,"text":"ٱلَّذِينَ هُمۡ يُرَآءُونَ"},{"id":7,"text":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ"}]},{"id":108,"name":"الكوثر","type":"meccan","total_verses":3,"verses":[{"id":1,"text":"إِنَّآ أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ"},{"id":2,"text":"فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ"},{"id":3,"text":"إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ"}]},{"id":109,"name":"الكافرون","type":"meccan","total_verses":6,"verses":[{"id":1,"text":"قُلۡ يَـٰٓأَيُّهَا ٱلۡكَٰفِرُونَ"},{"id":2,"text":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ"},{"id":3,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ"},{"id":4,"text":"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ"},{"id":5,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ"},{"id":6,"text":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ"}]},{"id":110,"name":"النصر","type":"medinan","total_verses":3,"verses":[{"id":1,"text":"إِذَا جَآءَ نَصۡرُ ٱللَّهِ وَٱلۡفَتۡحُ"},{"id":2,"text":"وَرَأَيۡتَ ٱلنَّاسَ يَدۡخُلُونَ 