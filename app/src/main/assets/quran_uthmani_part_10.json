{"source":"quran-json / The Noble Quran Encyclopedia; Arabic Uthmani text reproduced verbatim","surahs":[{"id":73,"name":"المزمل","type":"meccan","total_verses":20,"verses":[{"id":1,"text":"يَـٰٓأَيُّهَا ٱلۡمُزَّمِّلُ"},{"id":2,"text":"قُمِ ٱلَّيۡلَ إِلَّا قَلِيلٗا"},{"id":3,"text":"نِّصۡفَهُۥٓ أَوِ ٱنقُصۡ مِنۡهُ قَلِيلًا"},{"id":4,"text":"أَوۡ زِدۡ عَلَيۡهِ وَرَتِّلِ ٱلۡقُرۡءَانَ تَرۡتِيلًا"},{"id":5,"text":"إِنَّا سَنُلۡقِي عَلَيۡكَ قَوۡلٗا ثَقِيلًا"},{"id":6,"text":"إِنَّ نَاشِئَةَ ٱلَّيۡلِ هِيَ أَشَدُّ وَطۡـٔٗا وَأَقۡوَمُ قِيلًا"},{"id":7,"text":"إِنَّ لَكَ فِي ٱلنَّهَارِ سَبۡحٗا طَوِيلٗا"},{"id":8,"text":"وَٱذۡكُرِ ٱسۡمَ رَبِّكَ وَتَبَتَّلۡ إِلَيۡهِ تَبۡتِيلٗا"},{"id":9,"text":"رَّبُّ ٱلۡمَشۡرِقِ وَٱلۡمَغۡرِبِ لَآ إِلَٰهَ إِلَّا هُوَ فَٱتَّخِذۡهُ وَكِيلٗا"},{"id":10,"text":"وَٱصۡبِرۡ عَلَىٰ مَا يَقُولُونَ وَٱهۡجُرۡهُمۡ هَجۡرٗا جَمِيلٗا"},{"id":11,"text":"وَذَرۡنِي وَٱلۡمُكَذِّبِينَ أُوْلِي ٱلنَّعۡمَةِ وَمَهِّلۡهُمۡ قَلِيلًا"},{"id":12,"text":"إِنَّ لَدَيۡنَآ أَنكَالٗا وَجَحِيمٗا"},{"id":13,"text":"وَطَعَامٗا ذَا غُصَّةٖ وَعَذَابًا أَلِيمٗا"},{"id":14,"text":"يَوۡمَ تَرۡجُفُ ٱلۡأَرۡضُ وَٱلۡجِبَالُ وَكَانَتِ ٱلۡجِبَالُ كَثِيبٗا مَّهِيلًا"},{"id":15,"text":"إِنَّآ أَرۡسَلۡنَآ إِلَيۡكُمۡ رَسُولٗا شَٰهِدًا عَلَيۡكُمۡ كَمَآ أَرۡسَلۡنَآ إِلَىٰ فِرۡعَوۡنَ رَسُولٗا"},{"id":16,"text":"فَعَصَىٰ فِرۡعَوۡنُ ٱلرَّسُولَ فَأَخَذۡنَٰهُ أَخۡذٗا وَبِيلٗا"},{"id":17,"text":"فَكَيۡفَ تَتَّقُونَ إِن كَفَرۡتُمۡ يَوۡمٗا يَجۡعَلُ ٱلۡوِلۡدَٰنَ شِيبًا"},{"id":18,"text":"ٱلسَّمَآءُ مُنفَطِرُۢ بِهِۦۚ كَانَ وَعۡدُهُۥ مَفۡعُولًا"},{"id":19,"text":"إِنَّ هَٰذِهِۦ تَذۡكِرَةٞۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا"},{"id":20,"text":"۞إِنَّ رَبَّكَ يَعۡلَمُ أَنَّكَ تَقُومُ أَدۡنَىٰ مِن ثُلُثَيِ ٱلَّيۡلِ وَنِصۡفَهُۥ وَثُلُثَهُۥ وَطَآئِفَةٞ مِّنَ ٱلَّذِينَ مَعَكَۚ وَٱللَّهُ يُقَدِّرُ ٱلَّيۡلَ وَٱلنَّهَارَۚ عَلِمَ أَن لَّن تُحۡصُوهُ فَتَابَ عَلَيۡكُمۡۖ فَٱقۡرَءُواْ مَا تَيَسَّرَ مِنَ ٱلۡقُرۡءَانِۚ عَلِمَ أَن سَيَكُونُ مِنكُم مَّرۡضَىٰ وَءَاخَرُونَ يَضۡرِبُونَ فِي ٱلۡأَرۡضِ يَبۡتَغُونَ مِن فَضۡلِ ٱللَّهِ وَءَاخَرُونَ يُقَٰتِلُونَ فِي سَبِيلِ ٱللَّهِۖ فَٱقۡرَءُواْ مَا تَيَسَّرَ مِنۡهُۚ وَأَقِيمُواْ ٱلصَّلَوٰةَ وَءَاتُواْ ٱلزَّكَوٰةَ وَأَقۡرِضُواْ ٱللَّهَ قَرۡضًا حَسَنٗاۚ وَمَا تُقَدِّمُواْ لِأَنفُسِكُم مِّنۡ خَيۡرٖ تَجِدُوهُ عِندَ ٱللَّهِ هُوَ خَيۡرٗا وَأَعۡظَمَ أَجۡرٗاۚ وَٱسۡتَغۡفِرُواْ ٱللَّهَۖ إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمُۢ"}]},{"id":74,"name":"المدثر","type":"meccan","total_verses":56,"verses":[{"id":1,"text":"يَـٰٓأَيُّهَا ٱلۡمُدَّثِّرُ"},{"id":2,"text":"قُمۡ فَأَنذِرۡ"},{"id":3,"text":"وَرَبَّكَ فَكَبِّرۡ"},{"id":4,"text":"وَثِيَابَكَ فَطَهِّرۡ"},{"id":5,"text":"وَٱلرُّجۡزَ فَٱهۡجُرۡ"},{"id":6,"text":"وَلَا تَمۡنُن تَسۡتَكۡثِرُ"},{"id":7,"text":"وَلِرَبِّكَ فَٱصۡبِرۡ"},{"id":8,"text":"فَإِذَا نُقِرَ فِي ٱلنَّاقُورِ"},{"id":9,"text":"فَذَٰلِكَ يَوۡمَئِذٖ يَوۡمٌ عَسِيرٌ"},{"id":10,"text":"عَلَى ٱلۡكَٰفِرِينَ غَيۡرُ يَسِيرٖ"},{"id":11,"text":"ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدٗا"},{"id":12,"text":"وَجَعَلۡتُ لَهُۥ مَالٗا مَّمۡدُودٗا"},{"id":13,"text":"وَبَنِينَ شُهُودٗا"},{"id":14,"text":"وَمَهَّدتُّ لَهُۥ تَمۡهِيدٗا"},{"id":15,"text":"ثُمَّ يَطۡمَعُ أَنۡ أَزِيدَ"},{"id":16,"text":"كَلَّآۖ إِنَّهُۥ كَانَ لِأٓيَٰتِنَا عَنِيدٗا"},{"id":17,"text":"سَأُرۡهِقُهُۥ صَعُودًا"},{"id":18,"text":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ"},{"id":19,"text":"فَقُتِلَ كَيۡفَ قَدَّرَ"},{"id":20,"text":"ثُمَّ قُتِلَ كَيۡفَ قَدَّرَ"},{"id":21,"text":"ثُمَّ نَظَرَ"},{"id":22,"text":"ثُمَّ عَبَسَ وَبَسَرَ"},{"id":23,"text":"ثُمَّ أَدۡبَرَ وَٱسۡتَكۡبَرَ"},{"id":24,"text":"فَقَالَ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ يُؤۡثَرُ"},{"id":25,"text":"إِنۡ هَٰذَآ إِلَّا قَوۡلُ ٱلۡبَشَرِ"},{"id":26,"text":"سَأُصۡلِيهِ سَقَرَ"},{"id":27,"text":"وَمَآ أَدۡرَىٰكَ مَا سَقَرُ"},{"id":28,"text":"لَا تُبۡقِي وَلَا تَذَرُ"},{"id":29,"text":"لَوَّاحَةٞ لِّلۡبَشَرِ"},{"id":30,"text":"عَلَيۡهَا تِسۡعَةَ عَشَرَ"},{"id":31,"text":"وَمَا جَعَلۡنَآ أَصۡحَٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةٗۖ وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةٗ لِّلَّذِينَ كَفَرُواْ لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَيَزۡدَادَ ٱلَّذِينَ ءَامَنُوٓاْ إِيمَٰنٗا وَلَا يَرۡتَابَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَٱلۡمُؤۡمِنُونَ وَلِيَقُولَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٞ وَٱلۡكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلٗاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُۚ وَمَا يَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِيَ إِلَّا ذِكۡرَىٰ لِلۡبَشَرِ"},{"id":32,"text":"كَلَّا وَٱلۡقَمَرِ"},{"id":33,"text":"وَٱلَّيۡلِ إِذۡ أَدۡبَرَ"},{"id":34,"text":"وَٱلصُّبۡحِ إِذَآ أَسۡفَرَ"},{"id":35,"text":"إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ"},{"id":36,"text":"نَذِيرٗا لِّلۡبَشَرِ"},{"id":37,"text":"لِمَن شَآءَ مِنكُمۡ أَن يَتَقَدَّمَ أَوۡ يَتَأَخَّرَ"},{"id":38,"text":"كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ رَهِينَةٌ"},{"id":39,"text":"إِلَّآ أَصۡحَٰبَ ٱلۡيَمِينِ"},{"id":40,"text":"فِي جَنَّـٰتٖ يَتَسَآءَلُونَ"},{"id":41,"text":"عَنِ ٱلۡمُجۡرِمِينَ"},{"id":42,"text":"مَا سَلَكَكُمۡ فِي سَقَرَ"},{"id":43,"text":"قَالُواْ لَمۡ نَكُ مِنَ ٱلۡمُصَلِّينَ"},{"id":44,"text":"وَلَمۡ نَكُ نُطۡعِمُ ٱلۡمِسۡكِينَ"},{"id":45,"text":"وَكُنَّا نَخُوضُ مَعَ ٱلۡخَآئِضِينَ"},{"id":46,"text":"وَكُنَّا نُكَذِّبُ بِيَوۡمِ ٱلدِّينِ"},{"id":47,"text":"حَتَّىٰٓ أَتَىٰنَا ٱلۡيَقِينُ"},{"id":48,"text":"فَمَا تَنفَعُهُمۡ شَفَٰعَةُ ٱلشَّـٰفِعِينَ"},{"id":49,"text":"فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ"},{"id":50,"text":"كَأَنَّهُمۡ حُمُرٞ مُّسۡتَنفِرَةٞ"},{"id":51,"text":"فَرَّتۡ مِن قَسۡوَرَةِۭ"},{"id":52,"text":"بَلۡ يُرِيدُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفٗا مُّنَشَّرَةٗ"},{"id":53,"text":"كَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ"},{"id":54,"text":"كَلَّآ إِنَّهُۥ تَذۡكِرَةٞ"},{"id":55,"text":"فَمَن شَآءَ ذَكَرَهُۥ"},{"id":56,"text":"وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ"}]},{"id":75,"name":"القيامة","type":"meccan","total_verses":40,"verses":[{"id":1,"text":"لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ"},{"id":2,"text":"وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ"},{"id":3,"text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ"},{"id":4,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ"},{"id":5,"text":"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ"},{"id":6,"text":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ"},{"id":7,"text":"فَإِذَا بَرِقَ ٱلۡبَصَرُ"},{"id":8,"text":"وَخَسَفَ ٱلۡقَمَرُ"},{"id":9,"text":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ"},{"id":10,"text":"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ"},{"id":11,"text":"كَلَّا لَا وَزَرَ"},{"id":12,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ"},{"id":13,"text":"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ"},{"id":14,"text":"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ"},{"id":15,"text":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ"},{"id":16,"text":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ"},{"id":17,"text":"إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ"},{"id":18,"text":"فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ"},{"id":19,"text":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ"},{"id":20,"text":"كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ"},{"id":21,"text":"وَتَذَرُونَ ٱلۡأٓخِرَةَ"},{"id":22,"text":"وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ"},{"id":23,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٞ"},{"id":24,"text":"وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ"},{"id":25,"text":"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ"},{"id":26,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ"},{"id":27,"text":"وَقِيلَ مَنۡۜ رَاقٖ"},{"id":28,"text":"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ"},{"id":29,"text":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"},{"id":30,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ"},{"id":31,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ"},{"id":32,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ"},{"id":33,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ"},{"id":34,"text":"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ"},{"id":35,"text":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ"},{"id":36,"text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى"},{"id":37,"text":"أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ يُمۡنَىٰ"},{"id":38,"text":"ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ"},{"id":39,"text":"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ"},{"id":40,"text":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ"}]},{"id":76,"name":"الانسان","type":"medinan","total_verses":31,"verses":[{"id":1,"text":"هَلۡ أَتَىٰ عَلَى ٱلۡإِنسَٰنِ حِينٞ مِّنَ ٱلدَّهۡرِ لَمۡ يَكُن شَيۡـٔٗا مَّذۡكُورًا"},{"id":2,"text":"إِنَّا خَلَقۡنَا ٱلۡإِنسَٰنَ مِن نُّطۡفَةٍ أَمۡشَاجٖ نَّبۡتَلِيهِ فَجَعَلۡنَٰهُ سَمِيعَۢا بَصِيرًا"},{"id":3,"text":"إِنَّا هَدَيۡنَٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرٗا وَإِمَّا كَفُورًا"},{"id":4,"text":"إِنَّآ أَعۡتَدۡنَا لِلۡكَٰفِرِينَ سَلَٰسِلَاْ وَأَغۡلَٰلٗا وَسَعِيرًا"},{"id":5,"text":"إِنَّ ٱلۡأَبۡرَارَ يَشۡرَبُونَ مِن كَأۡسٖ كَانَ مِزَاجُهَا كَافُورًا"},{"id":6,"text":"عَيۡنٗا يَشۡرَبُ بِهَا عِبَادُ ٱللَّهِ يُفَجِّرُونَهَا تَفۡجِيرٗا"},{"id":7,"text":"يُوفُونَ بِٱلنَّذۡرِ وَيَخَافُونَ يَوۡمٗا كَانَ شَرُّهُۥ مُسۡتَطِيرٗا"},{"id":8,"text":"وَيُطۡعِمُونَ ٱلطَّعَامَ عَلَىٰ حُبِّهِۦ مِسۡكِينٗا وَيَتِيمٗا وَأَسِيرًا"},{"id":9,"text":"إِنَّمَا نُطۡعِمُكُمۡ لِوَجۡهِ ٱللَّهِ لَا نُرِيدُ مِنكُمۡ جَزَآءٗ وَلَا شُكُورًا"},{"id":10,"text":"إِنَّا نَخَافُ مِن رَّبِّنَا يَوۡمًا عَبُوسٗا قَمۡطَرِيرٗا"},{"id":11,"text":"فَوَقَىٰهُمُ ٱللَّهُ شَرَّ ذَٰلِكَ ٱلۡيَوۡمِ وَلَقَّىٰهُمۡ نَضۡرَةٗ وَسُرُورٗا"},{"id":12,"text":"وَجَزَىٰهُم بِمَا صَبَرُواْ جَنَّةٗ وَحَرِيرٗا"},{"id":13,"text":"مُّتَّكِـِٔينَ فِيهَا عَلَى ٱلۡأَرَآئِكِۖ لَا يَرَوۡنَ فِيهَا شَمۡسٗا وَلَا زَمۡهَرِيرٗا"},{"id":14,"text":"وَدَانِيَةً عَلَيۡهِمۡ ظِلَٰلُهَا وَذُلِّلَتۡ قُطُوفُهَا تَذۡلِيلٗا"},{"id":15,"text":"وَيُطَافُ عَلَيۡهِم بِـَٔانِيَةٖ مِّن فِضَّةٖ وَأَكۡوَابٖ كَانَتۡ قَوَارِيرَا۠"},{"id":16,"text":"قَوَارِيرَاْ مِن فِضَّةٖ قَدَّرُوهَا تَقۡدِيرٗا"},{"id":17,"text":"وَيُسۡقَوۡنَ فِيهَا كَأۡسٗا كَانَ مِزَاجُهَا زَنجَبِيلًا"},{"id":18,"text":"عَيۡنٗا فِيهَا تُسَمَّىٰ سَلۡسَبِيلٗا"},{"id":19,"text":"۞وَيَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ إِذَا رَأَيۡتَهُمۡ حَسِبۡتَهُمۡ لُؤۡلُؤٗا مَّنثُورٗا"},{"id":20,"text":"وَإِذَا رَأَيۡتَ ثَمَّ رَأَيۡتَ نَعِيمٗا وَمُلۡكٗا كَبِيرًا"},{"id":21,"text":"عَٰلِيَهُمۡ ثِيَابُ سُندُسٍ خُضۡرٞ وَإِسۡتَبۡرَقٞۖ وَحُلُّوٓاْ أَسَاوِرَ مِن فِضَّةٖ وَسَقَىٰهُمۡ رَبُّهُمۡ شَرَابٗا طَهُورًا"},{"id":22,"text":"إِنَّ هَٰذَا كَانَ لَكُمۡ جَزَآءٗ وَكَانَ سَعۡيُكُم مَّشۡكُورًا"},{"id":23,"text":"إِنَّا نَحۡنُ نَزَّلۡنَا عَلَيۡكَ ٱلۡقُرۡءَانَ تَنزِيلٗا"},{"id":24,"text":"فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تُطِعۡ مِنۡهُمۡ ءَاثِمًا أَوۡ كَفُورٗا"},{"id":25,"text":"وَٱذۡكُرِ ٱسۡمَ رَبِّكَ بُكۡرَةٗ وَأَصِيلٗا"},{"id":26,"text":"وَمِنَ ٱلَّيۡلِ فَٱسۡجُدۡ لَهُۥ وَسَبِّحۡهُ لَيۡلٗا طَوِيلًا"},{"id":27,"text":"إِنَّ هَـٰٓؤُلَآءِ يُحِبُّونَ ٱلۡعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمۡ يَوۡمٗا ثَقِيلٗا"},{"id":28,"text":"نَّحۡنُ خَلَقۡنَٰهُمۡ وَشَدَدۡنَآ أَسۡرَهُمۡۖ وَإِذَا شِئۡنَا بَدَّلۡنَآ أَمۡثَٰلَهُمۡ تَبۡدِيلًا"},{"id":29,"text":"إِنَّ هَٰذِهِۦ تَذۡكِرَةٞۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلٗا"},{"id":30,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمٗا"},{"id":31,"text":"يُدۡخِلُ مَن يَشَآءُ فِي رَحۡمَتِهِۦۚ وَٱلظَّـٰلِمِينَ أَعَدَّ لَهُمۡ عَذَابًا أَلِيمَۢا"}]},{"id":77,"name":"المرسلات","type":"meccan","total_verses":50,"verses":[{"id":1,"text":"وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا"},{"id":2,"text":"فَٱلۡعَٰصِفَٰتِ عَصۡفٗا"},{"id":3,"text":"وَٱلنَّـٰشِرَٰتِ نَشۡرٗا"},{"id":4,"text":"فَٱلۡفَٰرِقَٰتِ فَرۡقٗا"},{"id":5,"text":"فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا"},{"id":6,"text":"عُذۡرًا أَوۡ نُذۡرًا"},{"id":7,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ"},{"id":8,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتۡ"},{"id":9,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ"},{"id":10,"text":"وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ"},{"id":11,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ"},{"id":12,"text":"لِأَيِّ يَوۡمٍ أُجِّلَتۡ"},{"id":13,"text":"لِيَوۡمِ ٱلۡفَصۡلِ"},{"id":14,"text":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ"},{"id":15,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"},{"id":16,"text":"أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ"},{"id":17,"text":"ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ"},{"id":18,"text":"كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ"},{"id":19,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"},{"id":20,"text":"أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ"},{"id":21,"text":"فَجَعَلۡنَٰهُ فِي قَرَارٖ مَّكِينٍ"},{"id":22,"text":"إِلَىٰ قَدَرٖ مَّعۡلُومٖ"},{"id":23,"text":"فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ"},{"id":24,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"},{"id":25,"text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا"},{"id":26,"text":"أَحۡيَآءٗ وَأَمۡوَٰتٗا"},{"id":27,"text":"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا"},{"id":28,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"},{"id":29,"text":"ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"},{"id":30,"text":"ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ"},{"id":31,"text":"لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ"},{"id":32,"text":"إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ"},{"id":33,"text":"كَأَنَّهُۥ جِمَٰلَتٞ صُفۡرٞ"},{"id":34,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"},{"id":35,"text":"هَٰذَا يَوۡمُ لَا يَنطِقُونَ"},{"id":36,"text":"وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ"},{"id":37,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"},{"id":38,"text":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ"},{"id":39,"text":"فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ"},{"id":40,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"},{"id":41,"text":"إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ"},{"id":42,"text":"وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ"},{"id":43,"text":"كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ"},{"id":44,"text":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ"},{"id":45,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"},{"id":46,"text":"كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ"},{"id":47,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"},{"id":48,"text":"وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ"},{"id":49,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"},{"id":50,"text":"فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ"}]},{"id":78,"name":"النبإ","type":"meccan","total_verses":40,"verses":[{"id":1,"text":"عَمَّ يَتَسَآءَلُونَ"},{"id":2,"text":"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ"},{"id":3,"text":"ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ"},{"id":4,"text":"كَلَّا سَيَعۡلَمُونَ"},{"id":5,"text":"ثُمَّ كَلَّا سَيَعۡلَمُونَ"},{"id":6,"text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا"},{"id":7,"text":"وَٱلۡجِبَالَ أَوۡتَادٗا"},{"id":8,"text":"وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا"},{"id":9,"text":"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا"},{"id":10,"text":"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا"},{"id":11,"text":"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا"},{"id":12,"text":"وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا"},{"id":13,"text":"وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا"},{"id":14,"text":"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا"},{"id":15,"text":"لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا"},{"id":16,"text":"وَجَنَّـٰتٍ أَلۡفَافًا"},{"id":17,"text":"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا"},{"id":18,"text":"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا"},{"id":19,"text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا"},{"id":20,"text":"وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا"},{"id":21,"text":"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا"},{"id":22,"text":"لِّلطَّـٰغِينَ مَـَٔابٗا"},{"id":23,"text":"لَّـٰبِثِينَ فِيهَآ أَحۡقَابٗا"},{"id":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا"},{"id":25,"text":"إِلَّا حَمِيمٗا وَغَسَّاقٗا"},{"id":26,"text":"جَزَآءٗ وِفَاقًا"},{"id":27,"text":"إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا"},{"id":28,"text":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا"},{"id":29,"text":"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا"},{"id":30,"text":"فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا"},{"id":31,"text":"إِنَّ لِلۡمُتَّقِينَ مَفَازًا"},{"id":32,"text":"حَدَآئِقَ وَأَعۡنَٰبٗا"},{"id":33,"text":"وَكَوَاعِبَ أَتۡرَابٗا"},{"id":34,"text":"وَكَأۡسٗا دِهَاقٗا"},{"id":35,"text":"لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّـٰبٗا"},{"id":36,"text":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا"},{"id":37,"text":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا"},{"id":38,"text":"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَـٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا"},{"id":39,"text":"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱ