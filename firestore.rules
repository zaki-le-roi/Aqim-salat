rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.isActive == true
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.permissions == "ALL";
    }

    match /admins/{email} {
      allow read: if signedIn() && (
        email == request.auth.token.email ||
        activeSuperAdmin()
      );
      allow create, update, delete: if activeSuperAdmin();
    }

    // Deny all unspecified collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
